# Copy this file to .env and set a unique secret before production deployment.
APP_ENV=production
FLASK_SECRET_KEY=
OLLAMA_MODEL=gemma4:cloud
# Set this to a URL reachable from the cloud app. Do not use host.docker.internal in cloud.
OLLAMA_API_ENDPOINT=
OLLAMA_CONNECT_TIMEOUT_SECONDS=10
OLLAMA_READ_TIMEOUT_SECONDS=600
OLLAMA_KEEP_ALIVE=30m
